# YatraSathi Environment Variables Configuration



# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# LLM Configuration (Groq API Keys)
# Base key (used if specific ones aren't provided)
GROQ_API_KEY=your_groq_api_key_here

# Specific keys for load balancing (Optional but recommended)
GROQ_API_KEY_TRANSLATION=your_translation_groq_api_key
GROQ_API_KEY_PLANNER=your_planner_groq_api_key
GROQ_API_KEY_INSIGHTS=your_insights_groq_api_key

# NVIDIA Audio2Face Configuration
AUDIO2FACE_URL=http://localhost:8011

# OpenWeatherMap API Key
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key

# JWT Secret Key
SECRET_KEY=generate_a_random_secure_string_here

# Application Settings
DEBUG=True
APP_NAME="YatraSathi API"
